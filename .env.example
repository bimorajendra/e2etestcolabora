# Target application (black-box). Use the final URL after redirects if applicable.
BASE_URL=https://colabora.aksara.blog/
# Backend API origin (treated as first-party by the network monitor)
E2E_API_ORIGIN=https://api-colabora.anargya.fun

# Test accounts per role live in accounts.local.json (gitignored; see accounts.example.json).
# Never commit real credentials.

# Set to "true" ONLY if the target is a disposable test environment.
# When false, destructive/irreversible actions are never completed.
E2E_SAFE_ENV=false

# Comma-separated roles from accounts.local.json to run (empty = all)
E2E_ROLES=

